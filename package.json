{
  "name": "serverless-doc-pipeline",
  "version": "0.1.0",
  "description": "Multi-tenant document ingestion pipeline on AWS SAM: presigned uploads, S3 -> SQS -> Lambda processing, idempotent handlers",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "lint": "eslint \"{src,test,scripts}/**/*.ts\"",
    "format": "prettier --write \"{src,test,scripts}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --runInBand --testTimeout=120000",
    "test:all": "npm test && npm run test:int"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@smithy/util-stream": "^4.7.16",
    "@types/aws-lambda": "^8.10.162",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "5.7",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@aws-lambda-powertools/batch": "^2.34.0",
    "@aws-sdk/client-dynamodb": "^3.1105.0",
    "@aws-sdk/client-eventbridge": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/lib-dynamodb": "^3.1105.0",
    "@aws-sdk/s3-presigned-post": "^3.1103.0",
    "@aws-sdk/types": "^3.974.2",
    "csv-parse": "^7.0.2",
    "pdf-lib": "^1.17.1"
  }
}
